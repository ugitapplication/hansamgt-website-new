<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Legacy CodeIgniter index.php URLs → canonical clean URLs (SEO 301s, query preserved via QSA).
    # Laravel strips the script name before routing, so these must redirect here —
    # otherwise /index.php/<page> would serve a 200 duplicate instead of redirecting.
    # Never redirect form submissions (legacy parity: POSTs were excluded from redirects).
    RewriteCond %{REQUEST_METHOD} POST
    RewriteRule ^index\.php - [L]

    RewriteRule ^index\.php/home/history/?$ /company-profile [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/vision/?$ /mission-vision [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/charter/?$ /charter-of-unique-group [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/management/?$ /management [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/csr/?$ /corporate-social-responsibility [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/contact/?$ /contact [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/hardService/?$ /hospitality-management [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/softService/?$ /security-fire-life-safety [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/payperUse/?$ /cleaning-white-glove-housekeeping [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/riskManagement/?$ /mep-mechanical-electrical-plumbing [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/project/?$ /projects [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/siteManagement/?$ /gallery [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/index/?$ / [L,R=301,QSA,NC]
    RewriteRule ^index\.php/home/?$ / [L,R=301,QSA,NC]
    RewriteRule ^index\.php/(company-profile|mission-vision|charter-of-unique-group|management|corporate-social-responsibility|contact|hospitality-management|security-fire-life-safety|cleaning-white-glove-housekeeping|mep-mechanical-electrical-plumbing|projects|gallery)/?$ /$1 [L,R=301,QSA]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[/\s?] [NC]
    RewriteRule ^index\.php/?$ / [L,R=301,QSA]


    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Static asset caching.
#
# Scoped by URL path only. HTML/PHP responses, the contact form, the
# authenticated admin panel and error responses are never given a
# Cache-Control header here, so nothing that varies per visitor/session is
# shared-cached.
#
# Prerequisites: mod_headers and mod_setenvif (both standard in Apache 2.4
# builds). Each block is guarded, so a host without them skips these rules
# instead of returning a 500.
#
# `Header set` (not `Header always set`) applies to successful responses only,
# so 4xx/5xx — including the 403 from `Options -Indexes` — never receive these
# headers.
#
# NOT VERIFIED IN PRODUCTION: this file is the only web-server configuration
# tracked in this repository (there is no Nginx/Plesk config here). If the host
# runs Nginx, or ignores .htaccess, these rules have no effect until configured
# on the host. Confirm with `curl -I` against the real domain.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        # 1) Vite build output. File names carry a content hash
        #    (public/build/manifest.json -> assets/app-<hash>.css|js), so every
        #    build produces a brand-new URL. Safe to cache for a year, immutably.
        SetEnvIf Request_URI "^/build/" hansa_hashed_asset

        # 2) Replaceable assets with plain, unhashed names: public/images/** and
        #    the legacy fonts directly under public/fonts/**. They are
        #    overwritten in place, so they must NOT be immutable and must not be
        #    held for a year. Seven days bounds how long a replaced file can stay
        #    stale for returning visitors; rename the file (or append ?v=) to
        #    refresh it immediately.
        SetEnvIf Request_URI "^/(images|fonts)/" hansa_replaceable_asset

        # 3) Filament's published admin assets. Their URLs always carry a
        #    ?v=<package version> query (vendor/filament/support/src/Assets/
        #    Css.php, Js.php), so a Filament upgrade yields a new URL and a 30-day
        #    lifetime is safe.
        SetEnvIf Request_URI "^/(css|js)/" hansa_versioned_asset

        Header set Cache-Control "public, max-age=31536000, immutable" env=hansa_hashed_asset
        Header set Cache-Control "public, max-age=604800" env=hansa_replaceable_asset
        Header set Cache-Control "public, max-age=2592000" env=hansa_versioned_asset
    </IfModule>
</IfModule>
